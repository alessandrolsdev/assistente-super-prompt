# =========================
# Next.js (Frontend)
# =========================
# dependencies
frontend/node_modules/
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions

# testing
frontend/coverage/

# Next.js build output
frontend/.next/
frontend/out/
frontend/build/

# debug
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.pnpm-debug.log*

# Vercel
frontend/.vercel

# typescript
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# Variaveis de ambiente
frontend/.env
frontend/.env.*
frontend/.env*.local
!frontend/.env.example

# =========================
# .NET / C# (Backend)
# =========================
# Pastas de compilacao (binarios pesados) — inclui os projetos de teste
backend/**/bin/
backend/**/obj/
backend/TestResults/
backend/**/TestResults/

# Arquivo de configuracao sensivel local
backend/appsettings.Development.json
backend/appsettings.*.json
!backend/appsettings.Example.json

# Arquivos de cache e usuario do Visual Studio / VS Code
*.user
*.suo
.vscode/

# =========================
# Documentos de trabalho (ver AGENTS.md)
# =========================
# Auditorias, relatorios, analises e anotacoes descrevem um momento: ficam
# obsoletos rapido e nao pertencem ao historico do repositorio. O que precisa
# sobreviver a eles vira issue, ADR ou teste de regressao.
docs/audit/
docs/notes/
.notes/
scratch/
tmp/
*.local.md
AUDITORIA*.md
AUDIT*.md
RELATORIO*.md
ANALISE*.md
NOTES.md
SCRATCH.md
TODO.local.md

# Documentacao que E contrato do projeto continua versionada
!README.md
!AGENTS.md
!CONTRIBUTING.md
!docs/architecture/

# =========================
# OS / Geral
# =========================
.DS_Store
Thumbs.db
*.pem
